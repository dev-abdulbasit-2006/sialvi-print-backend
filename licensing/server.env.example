# Copy to your server's environment (systemd EnvironmentFile, Windows service env, Docker env ...).
# NO secrets belong in this file. The signing key and key pepper are generated into LICENSE_DATA_DIR
# on first start (key_pepper.secret, signing_key.pem) - back that folder up, never share it.
LICENSE_DATA_DIR=/var/lib/sialvi-license
LICENSE_HOST=127.0.0.1
LICENSE_PORT=8780
# Only if an HTTPS reverse proxy (Caddy/nginx) sits in front: its address(es). Leave empty otherwise.
LICENSE_TRUSTED_PROXIES=127.0.0.1
LICENSE_CHECKIN_INTERVAL_MINUTES=360
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_NOT_RECENT_MINUTES=720
LICENSE_OWNER_SESSION_HOURS=8
# Remote commands: how often PCs ask for commands (10-300 s), how long an undelivered command stays valid, poll/ack rate limit per IP per minute
LICENSE_POLL_INTERVAL_SECONDS=30
LICENSE_COMMAND_TTL_HOURS=72
LICENSE_POLL_RATE_LIMIT=300

# Hosts WITHOUT a persistent disk (Render free tier): keep the identity in secrets instead of files.
# Generate NEW values with:  python -m licensing.server render-secrets   (paste into the dashboard, keep a private backup)
LICENSE_KEY_PEPPER=
LICENSE_SIGNING_KEY_PEM=

# PERSISTENT storage (required on hosts with a temporary disk, e.g. Render free tier). Leave empty only for local development.
DATABASE_URL=
